# =============================================================================
# RENTIQ - Stage Environment Variables
# =============================================================================
# Copy this file to .env.stage and fill in real values
# NEVER commit .env.stage to version control
#
# Stage uses HOST-NATIVE services (not Docker):
#   - PostgreSQL on port 5433 (non-standard to avoid conflict with prod)
#   - Redis on port 6380
#   - MinIO on ports 9002 (API) / 9003 (console)

# -- Application --
NODE_ENV=development
LOG_LEVEL=debug

# -- PostgreSQL (stage, host-native on port 5433) --
POSTGRES_USER=rentiq
POSTGRES_PASSWORD=CHANGE_ME_STAGE_PASSWORD
POSTGRES_DB=rentiq-stage
POSTGRES_PORT=5433
DATABASE_URL=postgres://rentiq:CHANGE_ME_STAGE_PASSWORD@localhost:5433/rentiq-stage

# -- Redis (stage, host-native on port 6380) --
REDIS_URL=redis://localhost:6380

# -- MinIO (stage, host-native on ports 9002/9003) --
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=rentiq-stage
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# -- External Services --
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_TOKEN
MONOBANK_API_KEY=CHANGE_ME_MONOBANK_KEY
HA_TOKEN=CHANGE_ME_HOME_ASSISTANT_TOKEN

# -- Ports (stage, host-native) --
API_PORT=3002
ADMIN_PORT=3003
