# =============================================================================
# RENTIQ - Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values
# NEVER commit .env to version control

# -- Application --
NODE_ENV=production
LOG_LEVEL=info

# -- PostgreSQL (production) --
POSTGRES_USER=rentiq
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=rentiq
POSTGRES_PORT=5432
DATABASE_URL=postgres://rentiq:CHANGE_ME_STRONG_PASSWORD@localhost:5432/rentiq

# -- Redis (production) --
REDIS_URL=redis://localhost:6379

# -- MinIO (production) --
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=rentiq-prod
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# -- External Services --
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_TOKEN
MONOBANK_API_KEY=CHANGE_ME_MONOBANK_KEY
HA_TOKEN=CHANGE_ME_HOME_ASSISTANT_TOKEN

# -- IAM --
# Generate a stage/prod keypair with:
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Values must be the PEM contents (multi-line, quoted).
# Never rotate these without a strategy for live sessions (JWTs stay valid until TTL).
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
CHANGE_ME_RS256_PRIVATE_KEY_PEM
-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
CHANGE_ME_RS256_PUBLIC_KEY_PEM
-----END PUBLIC KEY-----"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
ADMIN_EMAIL=admin@rentiq.dev
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
# Per-org bot secret for POST /auth/telegram/exchange (dev seed org)
RENTIQ_DEV_TELEGRAM_SECRET=CHANGE_ME_DEV_BOT_SECRET

# -- Per-tenant secret encryption (AES-256-GCM) --
# 32-byte key, hex (64 chars) or base64 (44 chars). Generate with:
#   openssl rand -hex 32
# Used to encrypt/decrypt per-org Monobank/Checkbox tokens and per-station HA tokens.
# NEVER commit the real value; rotate by re-encrypting all secret columns.
MASTER_KEY=CHANGE_ME_32_BYTE_HEX_OR_BASE64_KEY

# -- Ports (production, internal to Docker) --
API_PORT=3000
ADMIN_PORT=3001
